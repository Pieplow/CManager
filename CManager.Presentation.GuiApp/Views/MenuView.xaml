<UserControl x:Class="CManager.Presentation.GuiApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CManager.Presentation.GuiApp.ViewModels"
             Height="300" Width="400">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock Text="Welcome to Customer Manager" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Button Content="Show Customers" Command="{Binding ShowCustomersCommand}" Width="150"/>
        <Button Content="Add Customer" Command="{Binding ShowAddCustomerCommand}" Width="150"/>

    </StackPanel>
</UserControl>
